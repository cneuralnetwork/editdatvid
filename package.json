  "description": "A private, browser-native video editor. Your media never leaves your machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cneuralnetwork/editdatvid.git"
  },
  "homepage": "https://github.com/cneuralnetwork/editdatvid#readme",
  "bugs": {
